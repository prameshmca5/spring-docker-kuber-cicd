{
  "title": "Spring Boot Microservices Overview",
  "uid": "spring-microservices",
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Service Health (UP = 1)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "value": 0, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      },
      "targets": [
        { "expr": "up{namespace=\"backend\"}", "legendFormat": "{{service}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Requests per Second (by service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"backend\"}[1m])) by (service, uri)", "legendFormat": "{{service}} {{uri}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 3,
      "title": "HTTP Error Rate (4xx/5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"backend\", status=~\"4..|5..\"}[1m])) by (service, status)", "legendFormat": "{{service}} {{status}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 4,
      "title": "Response Time P99 (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } } },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{namespace=\"backend\"}[1m])) by (service, le)) * 1000", "legendFormat": "{{service}} p99", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 5,
      "title": "JVM Heap Memory Used (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "decmbytes", "color": { "mode": "palette-classic" } } },
      "targets": [
        { "expr": "jvm_memory_used_bytes{namespace=\"backend\", area=\"heap\"} / 1024 / 1024", "legendFormat": "{{service}} heap", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 6,
      "title": "Payment Service — POST /api/v1/payments Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "fixedColor": "#FF6B6B", "mode": "fixed" } } },
      "targets": [
        { "expr": "rate(http_server_requests_seconds_count{service=\"payment-service\", uri=\"/api/v1/payments\", method=\"POST\"}[1m])", "legendFormat": "Payments Created/s", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 7,
      "title": "Active JVM Threads (by service)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal" },
      "targets": [
        { "expr": "jvm_threads_live_threads{namespace=\"backend\"}", "legendFormat": "{{service}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    },
    {
      "id": 8,
      "title": "GC Pause Time Rate (ms/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } } },
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_sum{namespace=\"backend\"}[1m]) * 1000", "legendFormat": "{{service}} GC", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ]
    }
  ]
}
